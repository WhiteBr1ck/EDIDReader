<controls:SectionedPage x:Class="EDIDReader.App.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EDIDReader.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,27,30,32">
            <controls:SelectableTextBlock Text="色彩与色域" Style="{StaticResource PageTitleStyle}" Margin="2,0,2,22"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <controls:SelectableTextBlock Text="CIE 1931 xy 色度图" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/>
                        <controls:CieChart Height="560"
                                           HasChromaticity="{Binding HasChromaticity}"
                                           RedX="{Binding RedX}" RedY="{Binding RedY}"
                                           GreenX="{Binding GreenX}" GreenY="{Binding GreenY}"
                                           BlueX="{Binding BlueX}" BlueY="{Binding BlueY}"
                                           WhiteX="{Binding WhiteX}" WhiteY="{Binding WhiteY}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel><controls:SelectableTextBlock Text="原色与白点" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="红色" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding RedPrimary, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                            <Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="绿色" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding GreenPrimary, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                            <Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="蓝色" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding BluePrimary, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                            <Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="白点" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding WhitePoint, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                            <Grid><controls:SelectableTextBlock Text="Gamma" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding Gamma, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel>
                            <controls:SelectableTextBlock Text="参考色域" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <controls:SelectableTextBlock Grid.Column="1" Text="覆盖率" Style="{StaticResource LabelStyle}" FontSize="11.5" HorizontalAlignment="Right"/>
                                <controls:SelectableTextBlock Grid.Column="2" Text="容积率" Style="{StaticResource LabelStyle}" FontSize="11.5" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <controls:SelectableTextBlock Text="sRGB" Style="{StaticResource LabelStyle}"/>
                                <controls:SelectableTextBlock Grid.Column="1" Text="{Binding SrgbCoverageText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" Style="{StaticResource MonoStyle}"/>
                                <controls:SelectableTextBlock Grid.Column="2" Text="{Binding SrgbVolumeText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" Style="{StaticResource MonoStyle}"/>
                            </Grid>
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <controls:SelectableTextBlock Text="Display P3" Style="{StaticResource LabelStyle}"/>
                                <controls:SelectableTextBlock Grid.Column="1" Text="{Binding P3CoverageText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource PurpleBrush}" FontWeight="Bold" Style="{StaticResource MonoStyle}"/>
                                <controls:SelectableTextBlock Grid.Column="2" Text="{Binding P3VolumeText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource PurpleBrush}" FontWeight="Bold" Style="{StaticResource MonoStyle}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                                <controls:SelectableTextBlock Text="BT.2020" Style="{StaticResource LabelStyle}"/>
                                <controls:SelectableTextBlock Grid.Column="1" Text="{Binding Bt2020CoverageText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource BlueBrush}" FontWeight="Bold" Style="{StaticResource MonoStyle}"/>
                                <controls:SelectableTextBlock Grid.Column="2" Text="{Binding Bt2020VolumeText, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{DynamicResource BlueBrush}" FontWeight="Bold" Style="{StaticResource MonoStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <StackPanel><controls:SelectableTextBlock Text="EDID 颜色格式" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding ColorFormats}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PillStyle}" Margin="0,0,7,7"><controls:SelectableTextBlock Text="{Binding Mode=OneWay}" FontWeight="Bold" FontSize="11.5"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel><controls:SelectableTextBlock Text="色度学声明" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,14"/><ItemsControl ItemsSource="{Binding Colorimetry}"><ItemsControl.ItemTemplate><DataTemplate><controls:SelectableTextBlock Text="{Binding Mode=OneWay}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</controls:SectionedPage>
