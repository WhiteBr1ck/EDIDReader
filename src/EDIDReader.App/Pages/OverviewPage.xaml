<controls:SectionedPage x:Class="EDIDReader.App.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EDIDReader.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,27,30,32">
            <controls:SelectableTextBlock Text="显示器概览" Style="{StaticResource PageTitleStyle}" Margin="2,0,2,22"/>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel><controls:SelectableTextBlock Text="当前连接" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding Connection, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/><controls:SelectableTextBlock Text="{Binding SourceName, Mode=OneWay}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel><controls:SelectableTextBlock Text="当前模式" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding Resolution, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/><controls:SelectableTextBlock Text="{Binding SignalSummary, Mode=OneWay}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                    <StackPanel><controls:SelectableTextBlock Text="{Binding ColorStateLabel, Mode=OneWay}" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding HdrStateText, Mode=OneWay}" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/><controls:SelectableTextBlock Text="{Binding HdrListText, Mode=OneWay}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,17"><controls:SelectableTextBlock Text="设备身份" Style="{StaticResource SectionTitleStyle}"/><Border HorizontalAlignment="Right" Style="{StaticResource PillStyle}" Padding="8,4"><controls:SelectableTextBlock Text="{Binding EdidVersion, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/></Border></Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                            <controls:SelectableTextBlock Grid.Row="0" Text="显示器名称" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><controls:SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name, Mode=OneWay}" Style="{StaticResource ValueStyle}" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Row="1" Text="厂商代码" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><controls:SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ManufacturerCode, Mode=OneWay}" Style="{StaticResource ValueStyle}" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Row="2" Text="产品代码" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><controls:SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProductCode, Mode=OneWay}" Style="{StaticResource ValueStyle}" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Row="3" Text="序列号" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><controls:SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SerialNumber, Mode=OneWay}" Style="{StaticResource ValueStyle}" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Row="4" Text="生产日期" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><controls:SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Manufactured, Mode=OneWay}" Style="{StaticResource ValueStyle}" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Row="5" Text="物理尺寸" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/><controls:SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PhysicalSize, Mode=OneWay}" Style="{StaticResource ValueStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <controls:SelectableTextBlock Text="EDID 完整性" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="14" Background="{DynamicResource GreenSoftBrush}"><controls:ReIcon Icon="CheckCircle" Width="21" Height="21" Foreground="{DynamicResource GreenBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><controls:SelectableTextBlock Text="{Binding EdidStatusText, Mode=OneWay}" FontWeight="Bold" TextWrapping="Wrap"/><controls:SelectableTextBlock Text="{Binding EdidBlockCountText, Mode=OneWay}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/></StackPanel></Grid>
                        <ItemsControl ItemsSource="{Binding EdidBlocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:SelectableTextBlock Text="{Binding IndexText, Mode=OneWay}" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Grid.Column="1" Text="{Binding Type, Mode=OneWay}"/><controls:SelectableTextBlock Grid.Column="2" Text="{Binding ChecksumText, Mode=OneWay}" Foreground="{DynamicResource GreenBrush}" FontSize="12" FontWeight="Bold"/></Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <controls:SelectableTextBlock Text="实际读取到的能力" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>
                    <ItemsControl ItemsSource="{Binding Capabilities}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PillStyle}" Margin="0,0,8,8"><controls:SelectableTextBlock Text="{Binding Mode=OneWay}" FontSize="12" FontWeight="Bold"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</controls:SectionedPage>
