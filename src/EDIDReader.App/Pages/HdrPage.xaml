<controls:SectionedPage x:Class="EDIDReader.App.Pages.HdrPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EDIDReader.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,27,30,32">
            <Grid Margin="2,0,2,22"><controls:SelectableTextBlock Text="HDR 信息" Style="{StaticResource PageTitleStyle}"/><Border HorizontalAlignment="Right" Style="{StaticResource PillStyle}" Background="{DynamicResource PurpleSoftBrush}" VerticalAlignment="Top"><controls:SelectableTextBlock Text="{Binding HdrListText, Mode=OneWay}" Foreground="{DynamicResource PurpleBrush}" FontWeight="Bold" FontSize="12"/></Border></Grid>

            <Border CornerRadius="18" Background="#2A2632" Padding="23" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="16" Background="#40384F"><controls:ReIcon Icon="Sun" Width="25" Height="25" Foreground="#B69BFF"/></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <controls:SelectableTextBlock Text="Windows 当前输出模式" Foreground="#B8AFC4" FontSize="11.5"/>
                        <controls:SelectableTextBlock Text="{Binding HdrOutputTitle, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="17" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource PillStyle}" Background="#423751" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><controls:SelectableTextBlock Text="HDR" Foreground="#DDD2FF" FontWeight="Bold" FontSize="11.5"/><controls:SelectableTextBlock Text="{Binding HdrWindowsStateText, Mode=OneWay}" Foreground="#C9B6FF" FontWeight="Bold" FontSize="11.5" Margin="6,0,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource PillStyle}" Background="#343A4C"><StackPanel Orientation="Horizontal"><controls:SelectableTextBlock Text="SDR ACM" Foreground="#C8E6FF" FontWeight="Bold" FontSize="11.5"/><controls:SelectableTextBlock Text="{Binding AcmStateText, Mode=OneWay}" Foreground="#9DD3FF" FontWeight="Bold" FontSize="11.5" Margin="6,0,0,0"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16"><StackPanel><controls:SelectableTextBlock Text="EDID EOTF" Style="{StaticResource LabelStyle}"/><ItemsControl ItemsSource="{Binding HdrEotfs}" Margin="0,9,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PillStyle}" Background="{DynamicResource PurpleSoftBrush}" Margin="0,0,7,5" Padding="9,4"><controls:SelectableTextBlock Text="{Binding Mode=OneWay}" Foreground="{DynamicResource PurpleBrush}" FontWeight="Bold" FontSize="11.5"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16"><StackPanel><controls:SelectableTextBlock Text="当前位深" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding ColorDepth, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="16"><StackPanel><controls:SelectableTextBlock Text="静态元数据" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding MetadataType, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="16"><StackPanel><controls:SelectableTextBlock Text="当前编码" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding ColorSpace, Mode=OneWay}" FontSize="16" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel><controls:SelectableTextBlock Text="CTA 声明亮度" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,18"/>
                    <Grid Margin="0,0,0,14"><controls:SelectableTextBlock Text="内容最大亮度" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding PeakLuminance, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                    <Grid Margin="0,0,0,14"><controls:SelectableTextBlock Text="帧平均最大亮度" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding AverageLuminance, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                    <Grid><controls:SelectableTextBlock Text="最小亮度" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding MinimumLuminance, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</controls:SectionedPage>
