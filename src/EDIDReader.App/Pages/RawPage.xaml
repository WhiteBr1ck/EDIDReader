<controls:SectionedPage x:Class="EDIDReader.App.Pages.RawPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EDIDReader.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,27,30,32">
            <Grid Margin="2,0,2,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:SelectableTextBlock Text="原始 EDID" Style="{StaticResource PageTitleStyle}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource QuietButtonStyle}" Margin="0,0,8,0" Content="复制字节" Click="CopyBytes_Click"/><Button Style="{StaticResource QuietButtonStyle}" Content="保存 bin" Click="SaveBinary_Click"/></StackPanel></Grid>

            <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="17"><StackPanel><controls:SelectableTextBlock Text="原始长度" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding RawByteCountText, Mode=OneWay}" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="17"><StackPanel><controls:SelectableTextBlock Text="数据块" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding EdidBlockCountText, Mode=OneWay}" FontSize="19" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="17"><StackPanel><controls:SelectableTextBlock Text="完整性" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding EdidStatusText, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel><controls:SelectableTextBlock Text="十六进制字节" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/><Border Background="{DynamicResource CodeSurfaceBrush}" CornerRadius="13" Padding="18"><TextBox Text="{Binding RawHexDump, Mode=OneWay}" FontFamily="Cascadia Mono" FontSize="12.5" Foreground="#F1EEE9" Background="Transparent" BorderThickness="0" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"/></Border></StackPanel>
            </Border>

            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}"><StackPanel><controls:SelectableTextBlock Text="数据块清单" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding EdidBlocks}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><controls:SelectableTextBlock Text="{Binding IndexText, Mode=OneWay}" Style="{StaticResource MonoStyle}"/><controls:SelectableTextBlock Grid.Column="1" Text="{Binding Type, Mode=OneWay}" FontWeight="Bold"/><controls:SelectableTextBlock Grid.Column="2" Text="{Binding SizeText, Mode=OneWay}" Style="{StaticResource MonoStyle}"/><controls:SelectableTextBlock Grid.Column="3" Text="{Binding ChecksumText, Mode=OneWay}" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><controls:SelectableTextBlock Text="解析摘要" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/><Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="版本" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding EdidVersion, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold"/></Grid><Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="输入定义" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding EdidInputDefinition, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold"/></Grid><Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="声明扩展数" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding DeclaredExtensionCount, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid><Grid Margin="0,0,0,12"><controls:SelectableTextBlock Text="扩展块" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding ExtensionSummary, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="250"/></Grid><Grid Margin="0,0,0,16"><controls:SelectableTextBlock Text="未知扩展" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding UnknownExtensionCount, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource MonoStyle}"/></Grid><ItemsControl ItemsSource="{Binding ParsedDataBlocks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PillStyle}" Margin="0,0,0,7" HorizontalAlignment="Left"><controls:SelectableTextBlock Text="{Binding Mode=OneWay}" FontSize="11.5" FontWeight="Bold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</controls:SectionedPage>
