<controls:SectionedPage x:Class="EDIDReader.App.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EDIDReader.App.Controls">
    <controls:SectionedPage.Resources>
        <Style x:Key="AudioSpecGroupStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AudioSpecTextStyle" TargetType="controls:SelectableTextBlock" BasedOn="{StaticResource {x:Type controls:SelectableTextBlock}}">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </controls:SectionedPage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,27,30,32">
            <Grid Margin="2,0,2,22">
                <controls:SelectableTextBlock Text="音频能力" Style="{StaticResource PageTitleStyle}"/>
                <Border HorizontalAlignment="Right" Style="{StaticResource PillStyle}" Background="{DynamicResource GreenSoftBrush}" VerticalAlignment="Top">
                    <controls:SelectableTextBlock Text="{Binding AudioFormats.Count, Mode=OneWay, StringFormat={}{0} 个音频描述符}" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" FontSize="12"/>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="17"><StackPanel><controls:SelectableTextBlock Text="最大声道数" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding AudioChannels, Mode=OneWay}" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="17"><StackPanel><controls:SelectableTextBlock Text="最高采样率" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding AudioSampleRate, Mode=OneWay}" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="17"><StackPanel><controls:SelectableTextBlock Text="LPCM 位深" Style="{StaticResource LabelStyle}"/><controls:SelectableTextBlock Text="{Binding AudioBitDepth, Mode=OneWay}" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,18" ClipToBounds="True">
                <StackPanel>
                    <Border Background="{DynamicResource TableHeaderBrush}" CornerRadius="16,16,0,0">
                        <Grid Height="48" ClipToBounds="True">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.48*"/><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                            <controls:SelectableTextBlock Text="格式" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="18,0,12,0" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Column="1" Text="声道" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Column="2" Text="采样率" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <controls:SelectableTextBlock Grid.Column="3" Text="位深或码率" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding AudioFormats}" HorizontalContentAlignment="Stretch" ClipToBounds="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,9" ClipToBounds="True">
                                    <Grid MinHeight="46">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.48*"/><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
                                        <controls:SelectableTextBlock Text="{Binding Format, Mode=OneWay}" FontWeight="Bold" Margin="18,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <controls:SelectableTextBlock Grid.Column="1" Text="{Binding ChannelText, Mode=OneWay}" Style="{StaticResource MonoStyle}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="2" Style="{StaticResource AudioSpecGroupStyle}" Margin="0,0,12,0">
                                            <controls:SelectableTextBlock Text="{Binding SampleRates, Mode=OneWay}" Style="{StaticResource AudioSpecTextStyle}"/>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource AudioSpecGroupStyle}" Margin="0,0,12,0">
                                            <controls:SelectableTextBlock Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource AudioSpecTextStyle}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <controls:SelectableTextBlock Text="扬声器分配" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,17"/>
                    <ItemsControl ItemsSource="{Binding SpeakerLayouts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="21" Height="21" CornerRadius="7" Background="{DynamicResource GreenSoftBrush}"><controls:ReIcon Icon="CheckCircle" Width="12" Height="12" Foreground="{DynamicResource GreenBrush}"/></Border>
                                    <controls:SelectableTextBlock Grid.Column="1" Text="{Binding Mode=OneWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:SectionedPage>
