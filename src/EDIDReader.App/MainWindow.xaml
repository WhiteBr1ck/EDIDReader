<Window x:Class="EDIDReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:EDIDReader.App.Controls"
        mc:Ignorable="d"
        Title="EDID Reader"
        Icon="Assets/AppIcon.ico"
        Width="1480"
        Height="900"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource ShellBrush}"
        ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="LibraryMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Width="40" Height="40" CornerRadius="11" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="9" Padding="10,8">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MonitorCardTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" Background="{Binding AccentSoftColor}" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <controls:ReIcon Icon="Display" Width="19" Height="19" Foreground="{Binding AccentColor}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="MonitorNameText" Text="{Binding Name, Mode=OneWay}" FontWeight="Bold" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    <TextBlock Text="{Binding ModeSummary, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    <StackPanel x:Name="LibraryTimestampLine" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock Text="保存于" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding LibrarySavedAtText, Mode=OneWay}" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Border Style="{StaticResource PillStyle}" Background="{Binding AccentSoftColor}" Padding="7,3">
                            <TextBlock Text="{Binding ConnectionShort, Mode=OneWay}" Foreground="{Binding AccentColor}" FontSize="10.5" FontWeight="Bold" IsHitTestVisible="False"/>
                        </Border>
                        <Border Style="{StaticResource PillStyle}" Padding="7,3" Margin="5,0,0,0">
                            <TextBlock Text="{Binding HdrListText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" FontWeight="Bold" IsHitTestVisible="False"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="SavedMonitorMenuButton" Grid.Column="1" Style="{StaticResource LibraryMenuButtonStyle}" Margin="0,-4,-6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Loaded="SavedMonitorMenu_Loaded" Click="SavedMonitorMenu_Click" ToolTip="更多操作" AutomationProperties.Name="已保存显示器操作">
                    <controls:ReIcon Icon="MoreHorizontal" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource LibraryContextMenuStyle}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource LibraryMenuItemStyle}" Click="RenameSavedMonitor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><controls:ReIcon Icon="Edit" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,0"/><TextBlock Text="重命名"/></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Style="{StaticResource LibraryMenuItemStyle}" Click="DeleteSavedMonitor_Click">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><controls:ReIcon Icon="Trash" Width="16" Height="16" Foreground="{DynamicResource RedBrush}" Margin="0,0,9,0"/><TextBlock Text="删除" Foreground="{DynamicResource RedBrush}"/></StackPanel></MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="MonitorNameText" Property="Margin" Value="0,0,38,0"/>
                    <Setter TargetName="LibraryTimestampLine" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="SavedMonitorMenuButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="CaptureRoot"
          Background="{DynamicResource ShellBrush}"
          RenderOptions.ClearTypeHint="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition x:Name="MonitorColumn" Width="286"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource RailBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Width="44" Height="44" VerticalAlignment="Center" ToolTip="EDID Reader">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#292622" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#9A8A78" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#C7B095" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,7"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#5E7180" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,7"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Center">
                    <RadioButton x:Name="OverviewNav" GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" IsChecked="True" Tag="overview" Checked="Navigation_Click" ToolTip="概览" AutomationProperties.Name="概览">
                        <controls:ReIcon Icon="Home" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="color" Checked="Navigation_Click" ToolTip="色彩" AutomationProperties.Name="色彩">
                        <controls:ReIcon Icon="Palette" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="hdr" Checked="Navigation_Click" ToolTip="HDR" AutomationProperties.Name="HDR">
                        <controls:ReIcon Icon="Sun" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="interface" Checked="Navigation_Click" ToolTip="接口与信号" AutomationProperties.Name="接口与信号">
                        <controls:ReIcon Icon="Link" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="timings" Checked="Navigation_Click" ToolTip="时序" AutomationProperties.Name="时序">
                        <controls:ReIcon Icon="Grid" Width="20" Height="20" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="audio" Checked="Navigation_Click" ToolTip="音频" AutomationProperties.Name="音频">
                        <controls:ReIcon Icon="Speaker" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="raw" Checked="Navigation_Click" ToolTip="原始数据" AutomationProperties.Name="原始数据">
                        <controls:ReIcon Icon="Code" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <RadioButton GroupName="PrimaryNavigation" Style="{StaticResource RailButtonStyle}" Tag="settings" Checked="Navigation_Click" ToolTip="设置" AutomationProperties.Name="设置">
                        <controls:ReIcon Icon="Settings" Width="21" Height="21" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Background="{DynamicResource ShellBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="25,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:SelectableTextBlock Text="EDID Reader" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <controls:SelectableTextBlock Text="›" Foreground="{DynamicResource SubtleBrush}" FontSize="20" Margin="12,0" VerticalAlignment="Center"/>
                    <controls:SelectableTextBlock x:Name="BreadcrumbMonitor" Text="正在读取" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <controls:SelectableTextBlock x:Name="BreadcrumbPageSeparator" Text="›" Foreground="{DynamicResource SubtleBrush}" FontSize="20" Margin="12,0" VerticalAlignment="Center"/>
                    <controls:SelectableTextBlock x:Name="BreadcrumbPage" Text="概览" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="MonitorActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:SelectableTextBlock x:Name="RefreshStatus" Text="正在读取 Windows 显示路径" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click" Margin="0,0,8,0" ToolTip="重新扫描当前显示器" AutomationProperties.Name="刷新">
                        <StackPanel Orientation="Horizontal">
                            <controls:ReIcon Icon="Refresh" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource QuietButtonStyle}" Click="ImportEdid_Click" Margin="0,0,8,0" ToolTip="导入 EDID 文件并加入显示器库" AutomationProperties.Name="导入 EDID">
                        <StackPanel Orientation="Horizontal">
                            <controls:ReIcon Icon="ArrowDown" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="导入" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveMonitorButton" Style="{StaticResource QuietButtonStyle}" Click="SaveEdid_Click" Margin="0,0,8,0" ToolTip="将当前活动显示器保存到本地显示器库" AutomationProperties.Name="保存 EDID">
                        <StackPanel Orientation="Horizontal">
                            <controls:ReIcon Icon="CheckCircle" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="保存" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportMenuButton" Style="{StaticResource QuietButtonStyle}" Click="ExportMenu_Click" ToolTip="导出选项" AutomationProperties.Name="导出选项">
                        <StackPanel Orientation="Horizontal">
                            <controls:ReIcon Icon="Export" Width="16" Height="16" Margin="0,0,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="导出" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource LibraryContextMenuStyle}" Placement="Bottom">
                                <MenuItem Style="{StaticResource LibraryMenuItemStyle}" Click="ExportEdid_Click">
                                    <MenuItem.Header><StackPanel Orientation="Horizontal"><controls:ReIcon Icon="ArrowUp" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,0"/><TextBlock Text="导出源文件"/></StackPanel></MenuItem.Header>
                                </MenuItem>
                                <MenuItem Style="{StaticResource LibraryMenuItemStyle}" Click="ExportSummaryImage_Click">
                                    <MenuItem.Header><StackPanel Orientation="Horizontal"><controls:ReIcon Icon="Grid" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}" Margin="0,0,9,0"/><TextBlock Text="导出图片"/></StackPanel></MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="MonitorPane"
                Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <controls:SelectableTextBlock Text="显示器" FontWeight="Bold" FontSize="17"/>
                    <controls:SelectableTextBlock x:Name="MonitorCountText" Text="正在扫描" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0"/>
                </StackPanel>

                <controls:SelectableTextBlock Grid.Row="1" Text="活动" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="1,18,0,8"/>

                <ListBox x:Name="MonitorList"
                         Grid.Row="2"
                         MaxHeight="300"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource MonitorItemStyle}"
                         SelectionChanged="MonitorList_SelectionChanged"
                         AutomationProperties.Name="显示器列表"
                         ItemTemplate="{StaticResource MonitorCardTemplate}"/>

                <Grid x:Name="SavedMonitorSectionHeader" Grid.Row="3" Margin="1,14,-8,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:SelectableTextBlock Text="已保存" Style="{StaticResource CaptionStyle}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <controls:SelectableTextBlock x:Name="SavedMonitorCountText" Grid.Column="1" Text="0" Style="{StaticResource CaptionStyle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource QuietButtonStyle}"
                            Margin="8,0,0,0"
                            Padding="10,0,8,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{DynamicResource RedBrush}"
                            Click="DeleteAllSaved_Click"
                            ToolTip="删除所有已保存的显示器"
                            AutomationProperties.Name="删除所有已保存的显示器">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <controls:ReIcon Icon="Trash" Width="15" Height="15" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="删除全部" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ListBox x:Name="SavedMonitorList"
                         Grid.Row="4"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource MonitorItemStyle}"
                         ItemTemplate="{StaticResource MonitorCardTemplate}"
                         SelectionChanged="SavedMonitorList_SelectionChanged"
                         AutomationProperties.Name="已保存显示器列表"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource PanelSoftBrush}">
            <ContentControl x:Name="PageHost"/>
        </Border>

        <Grid x:Name="LibraryDialogOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="3"
              Panel.ZIndex="1000"
              Background="#73000000"
              Visibility="Collapsed"
              PreviewKeyDown="LibraryDialog_PreviewKeyDown"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="440"
                    Padding="24"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LibraryDialogTitle" Text="重命名" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="LibraryDialogDescription" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <StackPanel x:Name="LibraryNameEditor" Margin="0,20,0,0">
                        <TextBlock Text="显示器名称" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                        <TextBox x:Name="LibraryNameTextBox"
                                 Height="44"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontFamily="Microsoft YaHei UI"
                                 FontSize="14"
                                 Foreground="{DynamicResource InkBrush}"
                                 CaretBrush="{DynamicResource InkBrush}"
                                 SelectionBrush="{DynamicResource PurpleBrush}"
                                 Background="{DynamicResource PanelSoftBrush}"
                                 BorderBrush="{DynamicResource LineBrush}"
                                 BorderThickness="1"
                                 FocusVisualStyle="{x:Null}"/>
                    </StackPanel>
                    <TextBlock x:Name="LibraryDialogError" Margin="0,9,0,0" Foreground="{DynamicResource RedBrush}" FontSize="12" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource QuietButtonStyle}" Content="取消" Margin="0,0,8,0" Click="LibraryDialogCancel_Click"/>
                        <Button x:Name="LibraryDialogConfirmButton" Style="{StaticResource QuietButtonStyle}" Content="确认" Click="LibraryDialogConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
